# Copy to .env (git-ignored) and adjust. No secrets are needed.

# Public host name; DNS A/AAAA record must point at this VM (ports 80 and 443 open).
# Leave "localhost" for a local test (browser will warn about Caddy's local certificate).
SITE_ADDRESS=localhost

# Where the built data lives (releases/<timestamp>/ and the "current" symlink).
# Relative paths are relative to this deploy/ directory; an absolute path on a big disk is better.
DATA_DIR=./data

# MOTIS release used for BOTH the server and the import. Change deliberately, then rebuild
# (docker compose build motis data) and re-run ./update-data.sh.
MOTIS_VERSION=v2.11.4

# Optional overrides of the download URLs in data/scripts/fetch.sh (used by update-data.sh).
# GTFS_URL=
# OSM_URL=
# PARKING_URL=

# Optional: the patched MOTIS for "last trip home with a zone pass" (see README.md).
# COMPOSE_FILE=compose.yml:compose.motis-fork.yml
# GHCR_OWNER=
