# syntax=docker/dockerfile:1
# MOTIS built from our fork: the per-request filter on allowed route segments. Same version as the release binary of Dockerfile.motis, so both read the same
# imported data. Building takes about 25 minutes on 4 cores; the image is built by the workflow
# .github/workflows/motis-fork-image.yml and pulled everywhere else.
#
#   docker build -f deploy/Dockerfile.motis-fork -t pendular-motis-fork .

ARG BASE=ubuntu:24.04

FROM ${BASE} AS build
# The fork: github.com/slvlirnoff/motis, branch segment-tags (v2.11.4 plus the filter). Its
# dependency file points at the segment-tags branch of github.com/slvlirnoff/nigiri.
# Pinned by commit: bump MOTIS_REF deliberately when the branch moves.
ARG MOTIS_REPO=https://github.com/slvlirnoff/motis.git
ARG MOTIS_REF=b3a7d30897f76efc3b7919a431eadfa3b6e88bdc
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git cmake ninja-build gcc-13 g++-13 \
    && rm -rf /var/lib/apt/lists/*
# MOTIS's dependency tool clones over ssh by default.
RUN git config --global url."https://github.com/".insteadOf "git@github.com:" \
    && git init -q /src/motis && git -C /src/motis fetch -q --depth 1 "${MOTIS_REPO}" "${MOTIS_REF}" \
    && git -C /src/motis checkout -q FETCH_HEAD
WORKDIR /build
# Configuring fetches the pinned dependencies; then build the server only.
RUN CC=gcc-13 CXX=g++-13 cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DNO_BUILDCACHE=ON \
      -DCMAKE_JOB_POOLS=link=1 -DCMAKE_JOB_POOL_LINK=link /src/motis \
    && ninja motis && ./motis --version

FROM ${BASE} AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin motis
COPY --from=build /build/motis /usr/local/bin/motis
USER motis
# The data directory is mounted here: config.yml and the indexes written by `motis import`.
# MOTIS_SEGMENT_TAGS points to the hop table (tools/motis-fork/export-segments.ts writes it).
WORKDIR /data
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8080/api/v1/health >/dev/null || exit 1
CMD ["motis", "server", "-d", "/data"]
