# syntax=docker/dockerfile:1
# Trajestaurant, any region (REGION=ch|vinnytsia, apps/trajestaurant/src/regions.ts): the site is
# built once and the API serves it with the region's name and languages, so one image runs every
# edition side by side (compose.trajestaurant.yml). Build context: the repository root.

FROM node:22-bookworm-slim AS base
ENV CI=true
RUN corepack enable
WORKDIR /app

# --- dependencies (cached until a manifest or the lockfile changes) ---
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/trajestaurant/package.json apps/trajestaurant/
COPY apps/api/package.json apps/api/
COPY packages/engine/package.json packages/engine/
# Root dev dependencies are kept on purpose: tsx (declared there) is what runs the API.
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    NODE_ENV=development pnpm install --frozen-lockfile --filter "@pendular/trajestaurant..." --filter "."

# --- the site (one build for every region) ---
FROM deps AS build
COPY tsconfig.base.json ./
COPY packages/engine packages/engine
# The API's HTTP client (server/server.ts imports it).
COPY apps/api/src/httpGet.ts apps/api/src/httpGet.ts
COPY apps/trajestaurant apps/trajestaurant
RUN pnpm --filter @pendular/trajestaurant build

# --- runtime: the API runs from its sources with tsx and serves web/dist ---
FROM build AS runtime
ENV NODE_ENV=production
USER node
# server.ts serves './web/dist' relative to the working directory.
WORKDIR /app/apps/trajestaurant
ENV REGION=ch PORT=8789
EXPOSE 8789
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/api/health').then(r=>r.json()).then(j=>process.exit(j.ok?0:1),()=>process.exit(1))"
CMD ["/app/node_modules/.bin/tsx", "server/server.ts"]
