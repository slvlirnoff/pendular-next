{
  "name": "pendular",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b packages/engine apps/api && pnpm --filter @pendular/web typecheck",
    "dev:api": "pnpm --filter @pendular/api dev",
    "dev:web": "pnpm --filter @pendular/web dev",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
